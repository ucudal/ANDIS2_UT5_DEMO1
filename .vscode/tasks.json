{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/ANDIS2_UT5_DEMO1.sln"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "ef: database drop",
      "type": "process",
      "command": "dotnet",
      "args": [
        "ef", "database", "drop", "--force",
        "--project", "Monolith.Infrastructure",
        "--startup-project", "Monolith.Web"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
